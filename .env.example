# ────────────────────────────────────────────────────────────────
#  Firebase-Konfiguration
# ────────────────────────────────────────────────────────────────
# So bekommst du diese Werte (dauert ~5 Min, kostenlos):
#   1. https://console.firebase.google.com  ->  "Projekt hinzufuegen"
#   2. Im Projekt:  Build -> Realtime Database -> Datenbank erstellen
#      (Region z.B. "europe-west1", Start im "gesperrten Modus")
#   3. Build -> Authentication -> Sign-in method -> "Anonym" aktivieren
#   4. Projektuebersicht (Zahnrad) -> "Meine Apps" -> Web-App </> hinzufuegen
#      -> aus dem angezeigten firebaseConfig die Werte hier eintragen
#   5. Diese Datei in ".env" umbenennen (Kopie machen) und Werte einsetzen
#
# WICHTIG: Ohne diese Werte startet die App automatisch im MOCK-MODUS
#          (laeuft lokal, Sync zwischen Browser-Tabs) - ideal zum Ausprobieren.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# Optionales, weiches Zugangs-Passwort fuers UI (leer = keine Abfrage).
# Achtung: steht im ausgelieferten Code, ist also kein echter Schutz -
# nur eine kleine Huerde gegen zufaellige Besucher der (unlisted) URL.
VITE_APP_PASSPHRASE=
